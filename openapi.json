  "components": {
    "securitySchemes": {
      "DemoBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "demo-manager-a / demo-operator-a / demo-viewer-a / demo-manager-b（公開デモキー）"
      }
    },
    "schemas": {
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenant": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "rejected",
              "failed",
              "cancelled"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "row_count": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "line": {
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Submission": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "csv"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "csv": {
            "type": "string",
            "description": "UTF-8、512KiB以内。1000明細以内。全件成功または全件拒否。"
          },
          "simulate_failures": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2,
            "default": 0
          }
        }
      },
      "Action": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "unit_price": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 100000000
          },
          "job_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Summary": {
        "type": "object",
        "properties": {
          "queued": {
            "type": "integer",
            "format": "int64"
          },
          "running": {
            "type": "integer",
            "format": "int64"
          },
          "completed": {
            "type": "integer",
            "format": "int64"
          },
          "rejected": {
            "type": "integer",
            "format": "int64"
          },
          "failed": {
            "type": "integer",
            "format": "int64"
          },
          "cancelled": {
            "type": "integer",
            "format": "int64"
          },
          "products": {
            "type": "integer",
            "format": "int64"
          },
          "catalog_value": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "数量×単価の合計。JSONの数値精度を保つため10進文字列。"
          }
        }
      }
    }
  }
}
